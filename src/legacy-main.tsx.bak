import React,{useState,useEffect} from 'react';
import {createRoot} from 'react-dom/client';
import {LayoutDashboard,Tags,MessageSquareText,ClipboardCheck,Search,Users,ChartNoAxesCombined,Bell,ShieldBan,UserRound,ChevronRight,ArrowUpRight,Plus,Menu,LogOut,Sun,Moon,ShieldCheck,ArrowRight,Download,Printer,Check,Clock,BriefcaseBusiness} from 'lucide-react';
import * as D from './data';import type {Case,User} from './data';import './style.css';import './theme.css';
const money=(n:number)=>'Rs. '+n.toLocaleString('en-PK');
const pages=['Dashboard','Classify Incidents','Follow-Ups / Findings','Submit Investigation','Track Incidents','Counterpart Help','Reports','Notifications','Blacklist','My Profile'];
const icons=[LayoutDashboard,Tags,MessageSquareText,ClipboardCheck,Search,Users,ChartNoAxesCombined,Bell,ShieldBan,UserRound];
const viewerPages=['Dashboard','Track Incidents','Reports'];
function Chip({children,tone=''}:{children:React.ReactNode;tone?:string}){return <span className={'chip '+tone}>{children}</span>}
function Field({label,children}:{label:string;children:React.ReactNode}){return <label className="field"><span>{label}</span>{children}</label>}
function Select({value,onChange,options,placeholder}:{value:string;onChange:(s:string)=>void;options:string[];placeholder?:string}){return <select value={value} onChange={e=>onChange(e.target.value)}>{placeholder&&<option value="">{placeholder}</option>}{options.map(o=><option key={o}>{o}</option>)}</select>}
function App(){
 const [user,setUser]=useState<User|null>(null),[page,setPage]=useState('Dashboard'),[client,setClient]=useState('All clients'),[theme,setTheme]=useState(localStorage.getItem('mohafiz-theme')||'dark'),[menu,setMenu]=useState(false),[version,refresh]=useState(0),[loading,setLoading]=useState(false),[message,setMessage]=useState(''),[error,setError]=useState(''),[busy,setBusy]=useState(false),[selected,setSelected]=useState(''),[search,setSearch]=useState(''),[query,setQuery]=useState(''),[tab,setTab]=useState('Pending'),[metric,setMetric]=useState(''),[pagination,setPagination]=useState(1),[blackEdit,setBlackEdit]=useState<D.Black|null>(null);
 const [email,setEmail]=useState('officer@mohafiz.demo'),[password,setPassword]=useState('demo'),[show,setShow]=useState(false);
 useEffect(()=>{document.documentElement.dataset.theme=theme;localStorage.setItem('mohafiz-theme',theme)},[theme]);
 const navigate=(p:string,id='')=>{setPage(p);setSelected(id);setMenu(false);setSearch('');setQuery('');setMessage('');setError('');setPagination(1);setLoading(true);setTimeout(()=>setLoading(false),250)};
 const run=async(fn:()=>Promise<any>,success='Saved successfully.')=>{if(busy)return;setBusy(true);setError('');setMessage('');try{await fn();refresh(v=>v+1);setMessage(success)}catch(e){setError((e as Error).message)}finally{setBusy(false)}};
 const scope=user?.role==='Client viewer'?user.client!:client;
 const cases=user?D.getCases(user,scope):[];
 const notes=user&&user.role!=='Client viewer'?D.getNotifications(user,scope):[];
 const open=(c:Case)=>{navigate('Incident detail',c.id);history.replaceState(null,'',`#case=${encodeURIComponent(c.id)}`)};
 useEffect(()=>{if(user&&location.hash.startsWith('#case=')){navigate('Incident detail',decodeURIComponent(location.hash.slice(6))) }},[user]);
 const changeClient=(c:string)=>{setClient(c);setSelected('');if(page==='Incident detail')setPage('Track Incidents');setQuery('');setMetric('');setPagination(1)};
 const track=(m:string,c?:string)=>{if(c)changeClient(c);navigate('Track Incidents');setMetric(m);setTab(m==='Closed'?'Closed':m==='In progress'?'In progress':'Pending')};
 const searchable=(c:Case)=>[c.id,c.internal,c.external,c.cn,c.name,c.employee].join(' ').toLowerCase().includes(query.toLowerCase());
 const matching=cases.filter(searchable);
 const denied=user?.role==='Client viewer'&&!['Dashboard','Track Incidents','Reports','Incident detail'].includes(page);
 const searchBar=<div className="searchbar"><Search size={18}/><input aria-label="Search cases" placeholder="Case ID, External ID, client reference or CN no." value={search} onChange={e=>setSearch(e.target.value)} onKeyDown={e=>{if(e.key==='Enter'){setQuery(search);setPagination(1)}}}/><button className="primary" onClick={()=>{setQuery(search);setPagination(1)}}>Search</button><button onClick={()=>{setQuery('');setSearch('')}}>Reset</button></div>;
 const empty=<div className="empty"><BriefcaseBusiness size={30}/><h3>No records to show</h3><p>Records matching your selected client and filters will appear here.</p></div>;
 const table=(rows:Case[],report=false)=><div className="table-wrap"><table><thead><tr>{(report?['Case ID','Client','External ID','Party name','Emp. ID','Date reported','Closure date','Incident type','Classification','FIR no.','Total amount','Recovered amount','Region']:['Case','Client','Reported','Victim / Accused','Incident type','Classification','Status','Current TAT','']).map((x,i)=><th key={i}>{x}</th>)}</tr></thead><tbody>{rows.map(c=><tr key={c.id}>{report?<><td><button className="link" onClick={()=>open(c)}>{c.id}</button></td><td>{c.client}</td><td>{c.external}</td><td>{c.name}</td><td>{c.employee}</td><td>{c.date}</td><td>{c.closed||'N/A'}</td><td>{c.type}</td><td>{c.classification}</td><td>{c.investigation?.firNumber||'—'}</td><td>{money(c.amount)}</td><td>{money(c.recovered)}</td><td>{c.region}</td></>:<><td><button className="case-link" onClick={()=>open(c)}>{c.id}</button><small>#{c.internal} · {c.external}</small></td><td><Chip tone={c.client.toLowerCase()}>{c.client}</Chip></td><td className="nowrap">{new Date(c.date+'T12:00:00').toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'})}</td><td><strong>{c.name}</strong><small>{c.party} · {c.employee}</small></td><td><strong>{c.type}</strong><small>{c.city} / {c.branch}</small></td><td><Chip tone={c.classification==='Not classified'?'warning':''}>{c.classification}</Chip></td><td><Chip tone={c.status==='Closed'?'good':c.status==='Pending'?'warning':'blue'}>{c.status}</Chip></td><td>{c.status==='Closed'?<span className="muted">Completed</span>:D.overdue(c)?<Chip tone="danger">Overdue</Chip>:<span className="muted">Due {c.due.slice(5)}</span>}</td><td><button className="link" onClick={()=>open(c)}>Open <ArrowUpRight size={14}/></button></td></>}</tr>)}</tbody></table>{!rows.length&&empty}</div>;
 const headerActions=page==='Dashboard'?<><button onClick={()=>navigate('Classify Incidents')}><Tags size={16}/>Classify Incidents</button><button className="primary" onClick={()=>navigate('Submit Investigation')}><Plus size={17}/>Submit Investigation</button></>:page==='Blacklist'?<button className="primary" onClick={()=>{setBlackEdit(null);navigate('Add Blacklist Candidate')}}><Plus size={18}/>Add Candidate</button>:null;
 if(!user)return <div className="login"><section className="login-story"><div className="wordmark"><ShieldCheck/>Mohafiz<span className="brand-dot"/></div><div><div className="eyebrow">SECURITY OPERATIONS, CONNECTED</div><h1>Incident Management<br/>System</h1><p>One controlled workspace.</p><div className="login-chips">{['Case reporting','Investigation','Follow-up','Management oversight'].map(x=><Chip key={x}>{x}</Chip>)}</div></div><small>MOHAFIZ INCIDENT WORKSPACE · PROTOTYPE</small></section><section className="login-form"><div className="login-card"><div className="eyebrow">WELCOME BACK</div><h2>Sign in</h2><p className="muted">Access your security operations workspace.</p><form onSubmit={e=>{e.preventDefault();run(async()=>{const u=await D.authenticate(email,password);setUser(u);setClient(u.client||'All clients')},'')}}><Field label="Email"><input type="email" required value={email} onChange={e=>setEmail(e.target.value)}/></Field><Field label="Password"><div className="password"><input required type={show?'text':'password'} value={password} onChange={e=>setPassword(e.target.value)}/><button type="button" onClick={()=>setShow(!show)}>{show?'Hide':'Show'}</button></div></Field>{error&&<p role="alert" className="error">{error}</p>}<button disabled={busy} className="primary full">{busy?'Signing in…':'Sign in securely'}<ArrowRight size={17}/></button></form><div className="demo"><strong>Explore the prototype</strong><p>All accounts use password <code>demo</code>.</p><Select value={email} onChange={setEmail} options={D.users.map(u=>u.email)}/></div><button className="link" onClick={()=>setTheme(theme==='dark'?'light':'dark')}>{theme==='dark'?<Sun size={16}/>:<Moon size={16}/>}Switch to {theme==='dark'?'light':'dark'} mode</button></div></section></div>;
 const current=(()=>{try{return selected?D.getCase(user,selected):null}catch{return null}})();
 return <div className="app"><aside className={menu?'sidebar mobile-open':'sidebar'}><div className="wordmark"><ShieldCheck size={27}/>Mohafiz<span className="brand-dot"/></div><div className="workspace-label">INCIDENT WORKSPACE</div><div className="sidebar-divider"/><div className="nav-label">WORKSPACE</div><nav>{pages.filter(p=>user.role!=='Client viewer'||viewerPages.includes(p)).map(p=>{const Icon=icons[pages.indexOf(p)];return <button key={p} className={(page===p||(p==='My Profile'&&page==='Clients')?'active ':'')+'nav-item'} onClick={()=>{setMetric('');navigate(p)}}><Icon size={18}/><span>{p}</span>{p==='Notifications'&&notes.filter(n=>!n.read).length>0&&<b className="count">{notes.filter(n=>!n.read).length}</b>}</button>})}</nav><div className="sidebar-bottom"><div className="secure"><ShieldCheck size={17}/><span>Controlled access<small>Sample data environment</small></span><span className="online"/></div><div className="sidebar-user"><span className="avatar">{user.name.split(' ').map(s=>s[0]).join('').slice(0,2)}</span><span><strong>{user.name}</strong><small>{user.role}</small></span><button aria-label="Sign out" onClick={()=>{setUser(null);history.replaceState(null,'',location.pathname)}}><LogOut size={17}/></button></div></div></aside>{menu&&<div className="scrim" onClick={()=>setMenu(false)}/>}
 <div className="main-shell"><header className="topbar"><button className="mobile-menu" aria-label="Open menu" onClick={()=>setMenu(!menu)}><Menu size={20}/></button><div className="breadcrumb">Workspace<ChevronRight size={14}/><strong>{page}</strong></div><div className="top-controls"><span className="login-as">Logged in as <strong>{user.name}</strong> · {user.role}</span>{user.role!=='Client viewer'?<Select value={client} onChange={changeClient} options={['All clients',...D.clients.map(c=>c.name)]}/>:<Chip>{user.client}</Chip>}<button className="icon-button theme-toggle" title={theme==="dark"?"Switch to light mode":"Switch to dark mode"} aria-pressed={theme==="light"} aria-label="Toggle light and dark theme" onClick={()=>setTheme(theme==='dark'?'light':'dark')}>{theme==='dark'?<Sun size={18}/>:<Moon size={18}/>}<span>{theme==='dark'?'Light mode':'Dark mode'}</span></button><button className="avatar" aria-label="Open profile" onClick={()=>navigate('My Profile')}>{user.name.split(' ').map(s=>s[0]).join('').slice(0,2)}</button><button className="icon-button" aria-label="Sign out" onClick={()=>setUser(null)}><LogOut size={17}/></button></div></header>
 <main><section className="page-header"><div><div className="eyebrow">{page==='Dashboard'?'OPERATIONS OVERVIEW':page==='My Profile'?'ACCOUNT':page==='Classify Incidents'?'SECURITY · PENDING CLASSIFICATION':'SECURITY OPERATIONS'}</div><h1>{page==='Dashboard'?`Welcome, ${user.name.split(' ')[0]}`:page==='Notifications'?'Inbox':page==='Blacklist'?'Security Blacklist':page==='Incident detail'&&current?`Case #${current.internal}`:page}</h1><p>{page==='Dashboard'?'A clear view of your incidents. Every client, one workspace.':page==='Incident detail'?current?.id:`${scope} · ${page==='Clients'?'Client configuration and service standards':'Manage, review and keep every case moving.'}`}</p></div>{user.role!=='Client viewer'&&<div className="header-actions">{headerActions}</div>}</section>
 <div className="content">{message&&<div className="notice success" role="status"><Check size={18}/>{message}<button onClick={()=>setMessage('')}>Dismiss</button></div>}{error&&<div className="notice error" role="alert">{error}<button onClick={()=>setError('')}>Dismiss</button></div>}
 {denied?<div className="empty"><ShieldBan/><h2>Permission denied</h2><p>Your role cannot access this page.</p></div>:loading?<div aria-label="Loading" className="skeleton">{[1,2,3,4,5].map(i=><div key={i}/>)}</div>:<>
 {page==='Dashboard'&&<><FlowGuide viewer={user.role==='Client viewer'} navigate={navigate}/><div className="section-line"><span><span className="online"/> Live workspace <span className="muted">/ {scope}</span></span><span className="muted">28 October 2026</span></div><div className="stats">{[['Total assigned',cases.length,BriefcaseBusiness,'all'],['Classified',cases.filter(c=>c.classification!=='Not classified').length,Tags,'Classified'],['Pending classification',cases.filter(c=>c.classification==='Not classified').length,Clock,'Pending classification'],['In progress',cases.filter(c=>c.status==='In progress').length,ClipboardCheck,'In progress'],['Closed',cases.filter(c=>c.status==='Closed').length,ShieldCheck,'Closed'],['Overdue TAT',cases.filter(D.overdue).length,Clock,'Overdue TAT'],['Follow-up due',cases.filter(c=>c.status!=='Closed'&&c.follow.length===0).length,MessageSquareText,'Follow-up due']].map(([label,n,Icon,key]:any,i)=><button className={'stat '+(i===5?'alert-stat':'')} key={key} onClick={()=>track(key)}><div className="stat-top"><span>{label}</span><Icon size={17}/></div><strong>{n.toString().padStart(2,'0')}</strong><div className="stat-bottom"><span>{i===0?'Across your workspace':i===5?'Needs your attention':i===4?'Successfully resolved':'View incidents'}</span><ArrowUpRight size={15}/></div></button>)}</div>
 {scope==='All clients'&&<section className="panel"><div className="panel-heading"><div><h2>By client</h2><p>Incident health across your client portfolio</p></div><Chip>{D.clients.filter(c=>c.active).length} active clients</Chip></div><div className="table-wrap"><table className="client-table"><thead><tr>{['Client','Open','Pending classification','Overdue TAT','Closed this month',''].map((s,i)=><th key={i}>{s}</th>)}</tr></thead><tbody>{D.clients.map((cl,i)=>{const cc=cases.filter(c=>c.client===cl.name);return <tr key={cl.name}><td><span className={'client-avatar color-'+i}>{cl.name.slice(0,2)}</span><strong>{cl.name}</strong><small className="inline-muted">{cl.prefix}</small></td>{[[cc.filter(c=>c.status!=='Closed').length,'Open'],[cc.filter(c=>c.classification==='Not classified').length,'Pending classification'],[cc.filter(D.overdue).length,'Overdue TAT'],[cc.filter(c=>c.closed?.startsWith('2026-10')).length,'Closed']].map(([n,k])=><td key={k}><button className={'number-link '+(k==='Overdue TAT'?'amber':'')} onClick={()=>track(String(k),cl.name)}>{n}</button></td>)}<td><button aria-label={`View ${cl.name}`} className="link" onClick={()=>track('all',cl.name)}><ArrowUpRight size={17}/></button></td></tr>})}</tbody></table></div></section>}
 <section className="panel"><div className="panel-heading"><div><h2>Recent incidents <span className="sub-count">{cases.length}</span></h2><p>The latest reported incidents in your workspace</p></div><button className="link" onClick={()=>track('all')}>View all incidents <ArrowRight size={16}/></button></div>{table([...cases].sort((a,b)=>b.date.localeCompare(a.date)).slice(0,10))}</section><div className="bottom-note"><ShieldCheck size={14}/> All information shown is fictional sample data.<span>MOHAFIZ · OPERATIONS WORKSPACE</span></div></>}
 {page==='Track Incidents'&&<>{searchBar}<div className="tabs">{['Pending','In progress','Closed'].map(t=><button className={!metric&&tab===t?'selected':''} onClick={()=>{setTab(t);setMetric('');setPagination(1)}} key={t}>{t} <span>{cases.filter(c=>c.status===t).length}</span></button>)}{metric&&<button className="selected" onClick={()=>setMetric('')}>{metric==='all'?'All incidents':metric} ×</button>}</div>{(()=>{const rows=matching.filter(c=>metric==='all'?true:metric==='Classified'?c.classification!=='Not classified':metric==='Pending classification'?c.classification==='Not classified':metric==='Overdue TAT'?D.overdue(c):metric==='Follow-up due'?c.status!=='Closed'&&!c.follow.length:metric==='Open'?c.status!=='Closed':c.status===(metric||tab));return <section className="panel">{table(rows.slice((pagination-1)*25,pagination*25))}<div className="pagination"><span>{rows.length} incidents · Page {pagination} of {Math.max(1,Math.ceil(rows.length/25))}</span><button disabled={pagination===1} onClick={()=>setPagination(pagination-1)}>Previous</button><button disabled={pagination*25>=rows.length} onClick={()=>setPagination(pagination+1)}>Next</button></div></section>})()}</>}
 {page==='Classify Incidents'&&<section className="panel"><div className="panel-heading"><div><h2>Pending classification</h2><p>Review the incident and record your initial assessment.</p></div><Chip>{cases.filter(c=>c.classification==='Not classified').length} cases</Chip></div>{!cases.filter(c=>c.classification==='Not classified').length?empty:<div className="table-wrap"><table><thead><tr>{['Case / Client','Date / Party','Incident','Region / Branch','Amount / TAT','Classification & initial remarks'].map(x=><th key={x}>{x}</th>)}</tr></thead><tbody>{cases.filter(c=>c.classification==='Not classified').map(c=><tr key={c.id}><td><button className="case-link" onClick={()=>open(c)}>{c.id}</button><Chip>{c.client}</Chip></td><td>{c.date}<small>{c.name} · {c.party}</small></td><td className="description"><strong>{c.type}</strong><p>{c.description}</p></td><td>{c.region}<small>{c.branch}</small></td><td>{money(c.amount)}<small>{D.overdue(c)?'Overdue':`Due ${c.due}`}</small></td><td><Classify c={c} user={user} busy={busy} run={run}/></td></tr>)}</tbody></table></div>}</section>}
 {['Follow-Ups / Findings','Submit Investigation','Counterpart Help'].includes(page)&&<>{searchBar}<div className="result-count">{matching.filter(c=>page!=='Submit Investigation'||c.status!=='Closed').length} matching cases</div>{matching.filter(c=>page!=='Submit Investigation'||c.status!=='Closed').length===0&&empty}{matching.filter(c=>page!=='Submit Investigation'||c.status!=='Closed').slice(0,query?45:8).map(c=><section className="panel work-card" key={c.id}><div className="work-details"><Chip tone={c.client.toLowerCase()}>{c.client}</Chip><button className="case-link" onClick={()=>open(c)}>{c.id}<ArrowUpRight size={15}/></button><small>{c.external} · {c.cn} · {c.date}</small><h3>{c.name}</h3><p>{c.type}</p><dl><dt>Party type</dt><dd>{c.party}</dd><dt>City / Branch</dt><dd>{c.branch}</dd><dt>Classification</dt><dd>{c.classification}</dd><dt>Amount</dt><dd>{money(c.amount)}</dd><dt>Status</dt><dd><Chip>{c.status}</Chip></dd></dl>{page==='Submit Investigation'&&c.client==='PostEx'&&<CopyBox c={c}/>}</div>{page==='Follow-Ups / Findings'?<><div className="work-history"><h3>Follow-up history</h3><Timeline c={c}/></div><FollowForm c={c} user={user} busy={busy} run={run}/></>:page==='Submit Investigation'?<Investigation c={c} user={user} busy={busy} run={run}/>:<HelpForm c={c} user={user} busy={busy} run={run}/>}</section>)}{!query&&matching.length>8&&<p className="muted">Showing the first 8 cases. Search for a case to narrow the list.</p>}</>}
 {page==='Incident detail'&&(current&&cases.some(c=>c.id===current.id)?<Detail c={current} user={user} busy={busy} run={run}/>:<div className="empty"><ShieldBan/><h2>Permission denied or case not found</h2><p>This case is outside your selected client or access.</p></div>)}
 {page==='Reports'&&<Reports cases={cases} scope={scope} user={user} table={table}/>}
 {page==='Notifications'&&<section className="panel"><div className="panel-heading"><h2>{notes.filter(n=>!n.read).length} unread</h2><button onClick={()=>{D.markRead(user,scope);refresh(v=>v+1)}}>Mark all read</button></div>{notes.length?notes.map(n=><button key={n.id} className={'notification '+(!n.read?'unread':'')} onClick={()=>{D.markRead(user,scope,n.id);open(D.getCase(user,n.caseId))}}><span className="notification-icon"><Bell size={18}/></span><span><strong>{n.client}: {n.message}</strong><small>{new Date(n.date).toLocaleString()} · {n.caseId}</small></span>{!n.read&&<Chip tone="blue">Unread</Chip>}<ChevronRight size={17}/></button>):empty}</section>}
 {page==='Blacklist'&&<Blacklist user={user} scope={scope} run={run} busy={busy} edit={(b:D.Black)=>{setBlackEdit(b);navigate('Add Blacklist Candidate')}}/>}
 {page==='Add Blacklist Candidate'&&<BlackForm user={user} scope={scope} record={blackEdit} run={run} busy={busy} back={()=>navigate('Blacklist')}/>}
 {page==='My Profile'&&<Profile user={user} busy={busy} run={run} clients={()=>navigate('Clients')}/>}
 {page==='Clients'&&<div className="client-settings">{D.clients.filter(c=>scope==='All clients'||c.name===scope).map(c=><section className="panel padded" key={c.name}><Chip tone={c.name.toLowerCase()}>{c.prefix}</Chip><h2>{c.name}</h2><dl><dt>Active</dt><dd>Yes</dd><dt>External reference</dt><dd>{c.reference} (optional)</dd><dt>Default TAT</dt><dd>{c.tat} days</dd><dt>Incident types</dt><dd>{c.types.join(' · ')}</dd><dt>Classifications</dt><dd>{c.classifications.join(' · ')}</dd><dt>Branches</dt><dd>{c.branches.join(' · ')}</dd></dl><p className="muted">Sample branches{c.name!=='PostEx'?' and incident list':''}, to be confirmed.</p></section>)}</div>}
 </>}
 <details className="prototype-tools"><summary>Prototype only · Demo controls</summary><div className="tools-row"><Field label="Switch sample account"><Select value={user.email} onChange={e=>{const u=D.users.find(u=>u.email===e)!;setUser(u);setClient(u.client||'All clients');navigate('Dashboard')}} options={D.users.map(u=>u.email)}/></Field><button onClick={()=>{D.failNext();setMessage('The next save will simulate a failure. Your form will be preserved.')}}>Simulate next save failure</button><button onClick={()=>{setLoading(true);setTimeout(()=>setLoading(false),1800)}}>Show loading state</button><button onClick={()=>setError('Permission denied. Your role cannot access this action or record.')}>Show permission state</button></div><p>Fictional data · Browser-memory records reset on refresh · Follow-up drafts persist on this device · Sign-in, files and notifications are simulated.</p></details>
 </div></main></div></div>;
}
function FlowGuide({viewer,navigate}:{viewer:boolean;navigate:(page:string)=>void}){
 const steps=viewer?[
  ['Review overview','Dashboard','Check totals and overdue cases for your company.'],
  ['Track a case','Track Incidents','Search a case and open its details and timeline.'],
  ['Review closure','Track Incidents','Use the Closed tab to see completed investigations.'],
  ['Export a report','Reports','Apply filters and download the matching records.']
 ]:[
  ['Classify','Classify Incidents','Review a pending case and record your initial assessment.'],
  ['Follow up','Follow-Ups / Findings','Collect verification facts, findings and evidence.'],
  ['Investigate & close','Submit Investigation','Record the final report, FIR and recovered amount.'],
  ['Track & report','Track Incidents','Review progress, closed cases and reporting results.']
 ];
 return <section className="panel flow-guide" aria-label="Workspace workflow"><div className="flow-heading"><div><h2>{viewer?'Your workspace at a glance':'How a case moves through the workspace'}</h2><p>{viewer?'Review your company’s cases from the overview through to reporting.':'Start with an existing case. Each step builds its investigation record.'}</p></div><Chip>{viewer?'Read-only access':'Pending ? In progress ? Closed'}</Chip></div><div className="flow-steps">{steps.map(([label,page,description],i)=><button className="flow-step" key={label} onClick={()=>navigate(page)}><span className="flow-number">{i+1}</span><span><strong>{label}</strong><small>{description}</small></span></button>)}</div><p className="flow-footnote">{viewer?'Your account is restricted to your company.':'Choose a client in the top bar to scope the whole workspace. Use Counterpart Help whenever another team needs to assist.'}</p></section>
}
function Classify({c,user,busy,run}:any){const [value,set]=useState(''),[remarks,setRemarks]=useState(''),[err,se]=useState('');return <form className="compact-form" onSubmit={e=>{e.preventDefault();if(!value||remarks.trim().length<10){se('Choose a classification and enter at least 10 characters.');return}se('');run(()=>D.classify(user,c.id,value,remarks),'Classification saved.')}}><Field label="Classification"><Select value={value} onChange={set} placeholder="Select classification" options={D.clients.find(x=>x.name===c.client)!.classifications}/></Field><Field label="Initial remarks"><textarea value={remarks} onChange={e=>setRemarks(e.target.value)} placeholder="At least 10 characters"/></Field>{err&&<p className="error">{err}</p>}<button disabled={busy} className="primary">Submit</button></form>}
function Timeline({c}:{c:Case}){return c.follow.length?<div className="timeline">{c.follow.map((f,i)=><div key={i}><strong>{f.author}</strong><small>{new Date(f.date).toLocaleString()}</small><p className="facts"><b>Structured facts</b> · CCTV: {f.facts.cctv||'Not recorded'} · Employee active: {f.facts.active||'Not recorded'} · Appointment date: {f.facts.appointment||'Not recorded'} · TAT required: {f.facts.tat||'Not recorded'} · Salary hold applicable: {f.facts.salary||'Not recorded'}</p><div className="report-text">{f.report}</div>{f.files.map((f,i)=><small key={i}>Attachment (simulated): {f}</small>)}</div>)}</div>:<p className="muted">No follow-ups recorded.</p>}
function FollowForm({c,user,busy,run}:any){const key=`mohafiz-draft-${user.id}-${c.id}`;const [v,set]=useState<any>(()=>{try{return JSON.parse(localStorage.getItem(key)||'null')||{report:'',facts:{cctv:'',active:'',appointment:'',tat:'',salary:''},files:[]}}catch{return {report:'',facts:{},files:[]}}}),[err,se]=useState('');useEffect(()=>{localStorage.setItem(key,JSON.stringify(v))},[v,key]);const fact=(k:string,value:string)=>set({...v,facts:{...v.facts,[k]:value}});return <form className="work-form" onSubmit={e=>{e.preventDefault();if(v.report.trim().length<20){se('Follow-up report needs at least 20 characters.');return}se('');run(async()=>{await D.addFollowUp(user,c.id,v);set({...v,report:'',files:[]})},'Follow-up saved.')}}><h3>Next follow-up</h3><div className="form-grid">{[['cctv','CCTV',['Available','Not available','Requested']],['active','Employee active',['Yes','No','Unknown']],['salary','Salary hold applicable',['Yes','No','Unknown']]].map(([k,l,o])=><Field key={k as string} label={l as string}><Select value={v.facts[k as string]||''} onChange={s=>fact(k as string,s)} placeholder="Select" options={o as string[]}/></Field>)}<Field label="Appointment date"><input type="date" value={v.facts.appointment||''} onChange={e=>fact('appointment',e.target.value)}/></Field><Field label="TAT required (days)"><input type="number" min="1" value={v.facts.tat||''} onChange={e=>fact('tat',e.target.value)}/></Field></div><Field label="Follow-up report"><textarea rows={5} value={v.report} onChange={e=>set({...v,report:e.target.value})} placeholder="Incident report: …&#10;Recommendation: …"/>{err&&<span className="error">{err}</span>}</Field><div className="form-grid">{['Upload statement','Upload other evidence'].map(l=><Field key={l} label={l}><input type="file" multiple onChange={e=>set({...v,files:[...v.files,...Array.from(e.target.files||[]).map(f=>`${l}: ${f.name}`)]})}/></Field>)}</div>{v.files.map((f:string,i:number)=><small key={i}>{f}</small>)}<div className="form-footer"><span className="muted"><Check size={14}/> Draft saves automatically</span><button disabled={busy} className="primary">{busy?'Saving…':'Submit Follow-Up'}</button></div></form>}
function Investigation({c,user,busy,run}:any){const [v,set]=useState<any>({fir:'No',firNumber:'',firDate:'',station:'',recovered:'0',basis:'',closing:'',report:'',remarks:'',files:[]}),[errs,se]=useState<Record<string,string>>({});const input=(k:string,l:string,type='text')=><Field label={l}><input type={type} value={v[k]} onChange={e=>set({...v,[k]:e.target.value})}/>{errs[k]&&<span className="error">{errs[k]}</span>}</Field>;return <form className="work-form" onSubmit={e=>{e.preventDefault();const er:Record<string,string>={};if(v.report.trim().length<30)er.report='Enter at least 30 characters.';if(!/^\d+$/.test(v.recovered)||Number(v.recovered)>c.amount)er.recovered='Enter digits only, up to the case amount.';if(v.fir==='Yes')for(const k of ['firNumber','firDate','station'])if(!v[k])er[k]='This field is required when FIR is registered.';if(!v.basis)er.basis='Choose a recovery basis.';if(!v.closing)er.closing='Choose a closing remark.';se(er);if(!Object.keys(er).length)run(()=>D.investigate(user,c.id,v),'Investigation saved. Case closed.')}}><h3>Investigation & closure</h3><div className="form-grid"><Field label="FIR registered"><Select value={v.fir} onChange={s=>set({...v,fir:s})} options={['No','Yes']}/></Field>{v.fir==='Yes'&&<>{input('firNumber','FIR number')}{input('firDate','FIR date','date')}{input('station','Police station')}</>}{input('recovered','Recovered amount')}<Field label="Recovery basis"><Select value={v.basis} onChange={s=>set({...v,basis:s})} placeholder="Select" options={['Cash recovery','Salary adjustment','Asset returned','No recovery']}/>{errs.basis&&<span className="error">{errs.basis}</span>}</Field><Field label="Closing remark"><Select value={v.closing} onChange={s=>set({...v,closing:s})} placeholder="Select" options={['Resolved','Recovery completed','Insufficient evidence','Administrative closure']}/>{errs.closing&&<span className="error">{errs.closing}</span>}</Field></div><div className="form-grid">{['FIR','Other evidence'].map(kind=><Field label={'Upload '+kind} key={kind}><input type="file" multiple onChange={e=>set({...v,files:[...v.files,...Array.from(e.target.files||[]).map(f=>({kind,name:f.name}))]})}/></Field>)}</div><Field label="Investigation report"><textarea rows={5} value={v.report} onChange={e=>set({...v,report:e.target.value})}/>{errs.report&&<span className="error">{errs.report}</span>}</Field><Field label="Recovery remarks"><textarea value={v.remarks} onChange={e=>set({...v,remarks:e.target.value})}/></Field><button disabled={busy} className="primary">{busy?'Saving…':'Submit investigation'}</button>{c.client==='PostEx'&&<CopyBox c={c} draft={v}/>}</form>}
function CopyBox({c,draft}:{c:Case;draft?:any}){const [copied,set]=useState(false);const v=draft||c.investigation||{};const text=`Case number: ${c.id}\nIMS case number: ${c.external}\nExternal ID: ${c.id}\nTotal amount: ${c.amount}\nRecovered: ${v.recovered??c.recovered}\nFIR: ${v.firNumber||'N/A'} · ${v.firDate||'N/A'} · ${v.station||'N/A'}\nReport: ${v.report||'Not submitted'}`;return <div className="copy-box"><h4>Copy for PostEx IMS</h4><pre>{text}</pre><button type="button" onClick={async()=>{try{await navigator.clipboard.writeText(text);set(true)}catch{set(false)}}}>{copied?'Copied':'Copy'}</button></div>}
function HelpForm({c,user,busy,run}:any){const [target,st]=useState(''),[reason,sr]=useState(''),[err,se]=useState('');return <form className="work-form" onSubmit={e=>{e.preventDefault();if(!target||reason.trim().length<10){se('Choose a counterpart and enter at least 10 characters.');return}se('');run(async()=>{await D.requestHelp(user,c.id,target,reason);sr('')},'Help request saved. The counterpart has been notified.')}}><h3>Request help</h3><Field label="Assign to"><Select value={target} onChange={st} placeholder="Select counterpart in another city" options={D.users.filter(u=>u.role!=='Client viewer'&&u.city!==user.city).map(u=>u.name)}/></Field><Field label="Reason"><textarea rows={4} value={reason} onChange={e=>sr(e.target.value)}/>{err&&<span className="error">{err}</span>}</Field><button disabled={busy} className="primary">Submit help request</button>{c.help.length>0&&<p>{c.help.length} request(s) · latest: {c.help[0].status}</p>}</form>}
function Detail({c,user,busy,run}:any){const [ref,sr]=useState(c.external),[comment,sc]=useState('');const pct=Math.round(c.recovered/c.amount*100);return <><section className="panel detail-hero"><div><div className="flex"><Chip tone={c.client.toLowerCase()}>{c.client}</Chip><span className="muted">{c.id}</span></div><h2>{c.name} <span className="muted">· {c.employee}</span></h2><div className="flex wrap">{[c.status,c.classification,c.type,c.branch].map(x=><Chip key={x}>{x}</Chip>)}</div><p className="muted">{c.description}</p></div><div className="financial"><span className="eyebrow">FINANCIAL EXPOSURE</span><h2>{money(c.amount)}</h2><div className="progress"><span style={{width:pct+'%'}}/></div><small>{pct}% recovered</small><div className="flex"><span>Recovered <strong>{money(c.recovered)}</strong></span><span>Remaining <strong>{money(c.amount-c.recovered)}</strong></span></div><p>Assigned to <strong>{c.assigned}</strong></p><button onClick={()=>window.print()}><Printer size={16}/> Print</button></div></section><section className="panel padded"><form className="reference-form" onSubmit={e=>{e.preventDefault();run(()=>D.saveCase(user,c.id,{external:ref}),'External reference updated.')}}><Field label={D.clients.find(x=>x.name===c.client)!.reference+' (optional)'}><input value={ref} readOnly={user.role==='Client viewer'} onChange={e=>sr(e.target.value)}/></Field>{user.role!=='Client viewer'&&<button disabled={busy} className="primary">Update</button>}</form></section><div className="detail-columns"><section className="panel padded"><h2>Case summary</h2><dl className="summary-grid">{Object.entries({'Client':c.client,'Incident date':c.incidentDate,'Reported at':c.date,'Incident type':c.type,'Party type':c.party,'Reported by':`${c.reporter} · ${c.phone}`,'Assigned to':c.assigned,'Region':c.region,'Branch':c.branch,'Party name':c.name,'Employee ID':c.employee,'Total amount':money(c.amount),'Recovered':money(c.recovered)}).map(([k,v])=><div key={k}><dt>{k}</dt><dd>{v as string}</dd></div>)}</dl></section><section className="panel padded"><h2>First follow-up · Verification facts</h2>{c.follow.length?<dl>{Object.entries(c.follow[c.follow.length-1].facts).map(([k,v])=><React.Fragment key={k}><dt>{{cctv:'CCTV',active:'Employee active',appointment:'Appointment date',tat:'TAT required',salary:'Salary hold applicable'}[k]}</dt><dd>{String(v)||'Not recorded'}</dd></React.Fragment>)}</dl>:<p className="muted">No structured verification recorded yet.</p>}</section></div><section className="panel padded"><h2>Evidence</h2><div className="evidence-grid">{['DR Sheet','Statement','FIR','Other evidence'].map(kind=><div className="evidence" key={kind}><ClipboardCheck size={20}/><h3>{kind}</h3><small>{c.files.filter((f:any)=>f.kind===kind).length} files</small>{c.files.filter((f:any)=>f.kind===kind).map((f:any,i:number)=><p key={i}>{f.name} (simulated)</p>)}</div>)}</div>{!c.files.length&&<p className="muted">No files attached.</p>}</section><section className="panel padded"><h2>Investigation report</h2>{c.investigation?<><p className="report-text">{c.investigation.report}</p><p>Recovery remarks: {c.investigation.remarks||'None'}</p><p>FIR: {c.investigation.firNumber||'N/A'}</p></>:<p className="muted">No investigation report submitted.</p>}{c.client==='PostEx'&&<CopyBox c={c}/>}</section><section className="panel padded"><h2>Follow-Ups / Findings</h2><Timeline c={c}/><h3>Case history</h3>{c.history.map((h:string,i:number)=><p className="muted" key={i}>{h}</p>)}</section>{user.role!=='Client viewer'&&<><section className="panel padded"><h2>Management Comments / Instructions</h2>{c.comments.length?c.comments.map((s:string,i:number)=><p key={i}>{s}</p>):<p className="muted">No instructions recorded.</p>}{user.role==='Manager'&&<form onSubmit={e=>{e.preventDefault();run(async()=>{await D.addComment(user,c.id,comment);sc('')},'Instruction saved.')}}><Field label="Add instruction (at least 10 characters)"><textarea required minLength={10} value={comment} onChange={e=>sc(e.target.value)}/></Field><button className="primary" disabled={busy}>Add instruction</button></form>}</section><section className="panel"><div className="panel-heading"><h2>Help requests</h2></div><div className="table-wrap"><table><thead><tr>{['Date','Requested by','Target user','Reason','Status','Management action'].map(x=><th key={x}>{x}</th>)}</tr></thead><tbody>{c.help.map((h:any,i:number)=><tr key={i}><td>{h.date}</td><td>{h.by}</td><td>{h.target}</td><td>{h.reason}</td><td><Chip>{h.status}</Chip></td><td>Awaiting review</td></tr>)}</tbody></table>{!c.help.length&&<div className="empty">No help requests recorded.</div>}</div></section></>}</>}
function Reports({cases,scope,user,table}:any){const initial={client:scope,from:'',to:'',type:'',classification:'',status:''};const [v,set]=useState(initial),[applied,sa]=useState(initial),[error,se]=useState('');useEffect(()=>{set(initial);sa(initial)},[scope]);const config=D.clients.filter(c=>v.client==='All clients'||c.name===v.client);const rows=cases.filter((c:Case)=>(applied.client==='All clients'||c.client===applied.client)&&(!applied.from||c.date>=applied.from)&&(!applied.to||c.date<=applied.to)&&(!applied.type||c.type===applied.type)&&(!applied.classification||c.classification===applied.classification)&&(!applied.status||c.status===applied.status));return <><section className="panel padded"><form onSubmit={e=>{e.preventDefault();if(v.from&&v.to&&v.to<v.from){se('Date to cannot be before Date from.');return}se('');sa({...v})}}><div className="report-filters"><Field label="Client"><Select value={v.client} onChange={s=>set({...v,client:s,type:'',classification:''})} options={user.role==='Client viewer'?[user.client]:scope==='All clients'?['All clients',...D.clients.map(c=>c.name)]:[scope]}/></Field><Field label="Date from"><input type="date" value={v.from} onChange={e=>set({...v,from:e.target.value})}/></Field><Field label="Date to"><input type="date" value={v.to} onChange={e=>set({...v,to:e.target.value})}/>{error&&<span className="error">{error}</span>}</Field><Field label="Incident type"><Select value={v.type} onChange={s=>set({...v,type:s})} options={[...new Set(config.flatMap(c=>c.types))]} placeholder="All types"/></Field><Field label="Classification"><Select value={v.classification} onChange={s=>set({...v,classification:s})} options={['Not classified',...new Set(config.flatMap(c=>c.classifications))]} placeholder="All classifications"/></Field><Field label="Status"><Select value={v.status} onChange={s=>set({...v,status:s})} options={['Pending','In progress','Closed']} placeholder="All statuses"/></Field></div><div className="flex"><button className="primary">Apply filters</button><button type="button" onClick={()=>{set(initial);sa(initial);se('')}}>Reset</button></div></form></section><section className="panel"><div className="panel-heading"><h2>{rows.length} matching records</h2><button onClick={()=>{const url=URL.createObjectURL(new Blob(['\uFEFF'+D.exportCSV(rows)],{type:'text/csv;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download='mohafiz-incidents.csv';a.click();URL.revokeObjectURL(url)}}><Download size={16}/>Export CSV</button></div>{table(rows,true)}</section></>}
function Blacklist({user,scope,run,busy,edit}:any){const [q,sq]=useState(''),[reasons,sr]=useState<Record<number,string>>({}),[errors,se]=useState<Record<number,string>>({});const rows=D.getBlacklist(user,scope).filter(b=>[b.name,b.cnic,b.city].join(' ').toLowerCase().includes(q.toLowerCase()));return <section className="panel"><div className="panel-heading"><h2>{rows.length} active records</h2><input aria-label="Search blacklist" placeholder="Name, CNIC or city" value={q} onChange={e=>sq(e.target.value)}/></div><div className="table-wrap"><table><thead><tr>{['Sr.','Picture','Name / employee code','CNIC','Client','Reported by','Region / City','Reason','Actions'].map(x=><th key={x}>{x}</th>)}</tr></thead><tbody>{rows.map((b,i)=><tr key={b.id}><td>{i+1}</td><td>{b.picture?<img className="picture" src={b.picture} alt={b.name}/>:<span className="avatar"><UserRound size={18}/></span>}</td><td><strong>{b.name}</strong><small>{b.employee}</small></td><td className="nowrap">{b.cnic.slice(0,5)}-XXXXXXX-{b.cnic.slice(-1)}</td><td><Chip>{b.client}</Chip></td><td>{b.reporter}</td><td>{b.region}<small>{b.city}</small></td><td className="description">{b.reason}{b.removal&&<p><Chip tone="warning">Removal pending</Chip><br/>{b.removal}</p>}</td><td><div className="compact-form"><button onClick={()=>edit(b)}>Edit</button><Field label="Removal reason"><textarea value={reasons[b.id]||''} onChange={e=>sr({...reasons,[b.id]:e.target.value})}/>{errors[b.id]&&<span className="error">{errors[b.id]}</span>}</Field><button disabled={busy} onClick={()=>{if((reasons[b.id]||'').trim().length<10){se({...errors,[b.id]:'Enter at least 10 characters.'});return}se({});run(()=>D.removeBlack(user,b.id,reasons[b.id]),'Removal requested. Waiting for manager approval.')}}>Request removal</button>{user.role==='Manager'&&b.removal&&<button disabled={busy} className="primary" onClick={()=>run(()=>D.removeBlack(user,b.id,b.removal!,true),'Removal approved.')}>Approve removal</button>}</div></td></tr>)}</tbody></table>{!rows.length&&<div className="empty">No matching blacklist records.</div>}</div></section>}
function BlackForm({user,scope,record,run,busy,back}:any){const [v,set]=useState<D.Black>(record||{id:0,client:scope==='All clients'?D.clients[0].name:scope,name:'',cnic:'',region:'',city:'',reason:'',employee:'DEMO-NEW',reporter:user.name}),[errors,se]=useState<Record<string,string>>({});return <section className="panel padded form-panel"><h2>{record?'Edit':'Add'} candidate</h2><form onSubmit={e=>{e.preventDefault();const er:Record<string,string>={};if(!v.name.trim())er.name='Enter a name.';if(!/^\d{13}$/.test(v.cnic))er.cnic='Enter all 13 CNIC digits.';if(!v.city)er.city='Enter a city.';if(!v.region)er.region='Enter a region.';if(v.reason.trim().length<20)er.reason='Enter at least 20 characters.';se(er);if(!Object.keys(er).length)run(async()=>{await D.saveBlack(user,v);back()},'Candidate saved.')}}><div className="form-grid"><Field label="Client"><Select value={v.client} onChange={s=>set({...v,client:s})} options={D.clients.map(c=>c.name)}/></Field>{[['name','Name'],['cnic','CNIC'],['region','Region'],['city','City']].map(([k,l])=><Field key={k} label={l}><input placeholder={k==='cnic'?'00000-0000000-0':l} value={k==='cnic'?v.cnic.replace(/^(\d{5})(\d{0,7})(\d{0,1})$/,(_,a,b,c)=>a+'-'+b+(c?'-'+c:'')):(v as any)[k]} onChange={e=>set({...v,[k]:k==='cnic'?e.target.value.replace(/\D/g,'').slice(0,13):e.target.value})}/>{errors[k]&&<span className="error">{errors[k]}</span>}</Field>)}<Field label="Picture (image, 2 MB max)"><input type="file" accept="image/*" onChange={e=>{const f=e.target.files?.[0];if(!f)return;if(!f.type.startsWith('image/')||f.size>2*1024*1024){se({...errors,picture:'Choose an image no larger than 2 MB.'});return}se({...errors,picture:''});const reader=new FileReader();reader.onload=()=>set({...v,picture:reader.result as string});reader.readAsDataURL(f)}}/>{errors.picture&&<span className="error">{errors.picture}</span>}</Field></div><Field label="Reason"><textarea rows={4} value={v.reason} onChange={e=>set({...v,reason:e.target.value})}/>{errors.reason&&<span className="error">{errors.reason}</span>}</Field><div className="flex wrap"><button className="primary" disabled={busy||!!errors.picture}>Save Candidate</button><button type="button" onClick={back}>Cancel</button><button className="link" type="button" onClick={back}>Back to Blacklist</button></div></form></section>}
function Profile({user,busy,run,clients}:any){const [v,set]=useState({...user});return <section className="panel padded form-panel"><div className="panel-heading"><div><h2>My profile</h2><p>Keep your contact and operational details up to date.</p></div><span className="avatar large">{user.name[0]}</span></div><form onSubmit={e=>{e.preventDefault();run(()=>D.updateProfile(user,v),'Profile updated.')}}><div className="form-grid">{[['name','Name'],['phone','Contact number'],['employee','Employee ID'],['email','Email'],['designation','Designation'],['role','Role'],['region','Region'],['branch','Branch'],['unit','Security unit']].map(([k,l])=><Field label={l} key={k}><input required value={v[k]} readOnly={['employee','email','role'].includes(k)} pattern={k==='phone'?'03[0-9]{9}':undefined} title={k==='phone'?'Use 03XXXXXXXXX':undefined} onChange={e=>set({...v,[k]:e.target.value})}/></Field>)}</div><p className="muted">Sign-in is managed centrally.</p><div className="flex"><button disabled={busy} className="primary">Update Profile</button><button type="button" onClick={clients}>View Clients <ArrowUpRight size={16}/></button></div></form></section>}
createRoot(document.getElementById('root')!).render(<App/>);



